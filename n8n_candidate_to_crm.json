{
  "name": "Rh-prospects - Candidate to CRM",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "candidate-submission",
        "options": {}
      },
      "name": "Webhook Candidate",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "resource": "contact",
        "operation": "upsert",
        "email": "={{$node[\"Webhook Candidate\"].json[\"email\"]}}",
        "additionalFields": {
          "firstName": "={{$node[\"Webhook Candidate\"].json[\"firstName\"]}}",
          "lastName": "={{$node[\"Webhook Candidate\"].json[\"lastName\"]}}",
          "phone": "={{$node[\"Webhook Candidate\"].json[\"phone\"]}}",
          "customProperties": {
            "cv_url": "={{$node[\"Webhook Candidate\"].json[\"cvUrl\"]}}",
            "source": "Rh-prospects"
          }
        }
      },
      "name": "Upsert CRM Contact",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 1,
      "position": [500, 300]
    }
  ],
  "connections": {
    "Webhook Candidate": {
      "main": [
        [
          {
            "node": "Upsert CRM Contact",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
